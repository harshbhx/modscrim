{
  "name": "mod-fire-drill",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "test": "npm run test -w packages/core && npm run test -w app",
    "typecheck": "tsc -b",
    "types": "npm run types -w app",
    "db:migrate:local": "npm run db:migrate:local -w app",
    "db:migrate:remote": "npm run db:migrate:remote -w app",
    "build": "npm run build -w app",
    "deploy": "npm run deploy -w app",
    "lint:tokens": "node scripts/lint-action-border.mjs",
    "contrast:check": "node scripts/contrast-check.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report app/e2e/report",
    "load": "node --experimental-strip-types scripts/load.ts",
    "subscribe-revoke": "node --experimental-strip-types scripts/subscribe-revoke.ts",
    "site:tokens": "node scripts/sync-site-tokens.mjs",
    "site:tokens:check": "node scripts/sync-site-tokens.mjs --check",
    "site:colours": "node scripts/check-site-colours.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "playwright": "^1.49.1",
    "typescript": "^5.9.3"
  }
}
