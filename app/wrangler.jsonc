{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mod-fire-drill",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-28",
  "upload_source_maps": true,
  "workers_dev": true,
  "routes": [{ "pattern": "app.modscrim.dualmindlab.tech", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/ws/*", "/eventsub"]
  },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "ChannelRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChannelRoom"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "mfd", "database_id": "e28e6c2c-9a50-4f08-a622-a563c3baadfb", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["7 * * * *"] },
  "ratelimits": [
    { "name": "JOIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "DEMO_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "TWITCH_CLIENT_ID": "arbdhhcofj5c61yidld9xdvb4tue3s",
    "CHAT_LOG_RETENTION_DAYS": "7",
    "CLEAN_SET_MAX_LINES": "20000",
    "GRADING_ENGINE": "twitch",
    "GRADING_BATCH_SIZE": "100",
    "GRADING_QUOTA_UNIT": "request",
    "DEMO_ENABLED": "true",
    "ANNOUNCE_ENABLED": "false",
    "COACH_AI_ENABLED": "false"
  },
  "secrets": { "required": ["PUBLIC_BASE_URL", "TWITCH_CLIENT_SECRET", "EVENTSUB_SECRET", "SESSION_HMAC_KEY", "TOKEN_ENC_KEY"] },

  // Preview environment for pull requests: its own Worker (mod-fire-drill-preview) and its own
  // D1 database, on workers.dev only. Built with CLOUDFLARE_ENV=preview. It never touches
  // production data, has no cron, and grades locally because Twitch sign-in is production-only.
  "env": {
    "preview": {
      "routes": [],
      "workers_dev": true,
      "triggers": { "crons": [] },
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "ChannelRoom" }] },
      "d1_databases": [
        { "binding": "DB", "database_name": "mfd-preview", "database_id": "b4ed3423-cdd5-4695-8b9e-e293271a54f7", "migrations_dir": "migrations" }
      ],
      "ratelimits": [
        { "name": "JOIN_LIMITER", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "DEMO_LIMITER", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
        { "name": "AUTH_LIMITER", "namespace_id": "2003", "simple": { "limit": 20, "period": 60 } }
      ],
      "vars": {
        "TWITCH_CLIENT_ID": "arbdhhcofj5c61yidld9xdvb4tue3s",
        "CHAT_LOG_RETENTION_DAYS": "7",
        "CLEAN_SET_MAX_LINES": "20000",
        "GRADING_ENGINE": "local",
        "GRADING_BATCH_SIZE": "100",
        "GRADING_QUOTA_UNIT": "request",
        "DEMO_ENABLED": "true",
        "ANNOUNCE_ENABLED": "false",
        "COACH_AI_ENABLED": "false"
      },
      "secrets": { "required": ["PUBLIC_BASE_URL", "TWITCH_CLIENT_SECRET", "EVENTSUB_SECRET", "SESSION_HMAC_KEY", "TOKEN_ENC_KEY"] }
    }
  }
}
