# Security headers for the static site on Cloudflare Pages, adapted from SRS §9.6.
# script-src allows site.js plus, by hash, only the onsubmit="return false" handler used
# twice in console.html. style-src needs 'unsafe-inline' for the style attributes in the
# pages and in the markup site.js builds. Everything else, fonts included, is same-origin.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-hashes' 'sha256-GZIcz60Uwd6wT3vaYke/atSr53TehbYAPepOa3d03Vw='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the pages.dev hostnames out of search results; the custom domain is canonical.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
